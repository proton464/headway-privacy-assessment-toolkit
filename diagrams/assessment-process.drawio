<mxfile host="app.diagrams.net">
  <diagram name="Privacy Assessment Process">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="Product / AI / Vendor Privacy Assessment Process" style="text;html=1;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="360" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="intake" value="Intake&#xa;(Product, AI, or Vendor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="checklist" value="Complete Assessment&#xa;Checklist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="280" y="80" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="risk" value="Risk Rating &&#xa;Findings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="baa" value="BAA / Vendor&#xa;Check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="180" y="180" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="escalate" value="Escalate to Legal&#xa;(if needed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="360" y="180" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="decision" value="Decision &&#xa;Documentation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="280" y="280" width="140" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>